{
  "mcpServers": {
    "tinysearch": {
      "type": "http",
      "url": "http://localhost:8765/mcp"
    },
    "Home Assistant": {
      "type": "http",
      "url": "http://haserver.local:8123/api/mcp",
      "headers": {
        "Authorization": "Bearer <long lived access token>"
      },
      "toolOverrides": {
        "GetLiveContext": {
          "description": "Get the current state of Home Assistant entities (sensors, switches, lights, media players, etc).\nUSAGE:\n  - Call with NO arguments first to discover ALL available entities and their current states.\n  - Then use the results to make targeted filtered queries.\nFILTERS (all optional, can be combined):\n  name:  Case-insensitive partial match on entity name. Examples: \"car battery level\", \"pool temperature\".\n  domain: Entity type — \"sensor\", \"switch\", \"light\", \"lock\", \"media_player\", \"binary_sensor\", \"automation\", \"cover\", \"climate\".\n  area:  Area or room name — \"Kitchen\", \"Lounge\", \"Bedroom\", etc."
        }
      }
    }
  }
}
