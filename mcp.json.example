{
  "mcpServers": {
    "tinysearch": {
      "type": "http",
      "url": "http://localhost:8765/mcp"
    },
    "Home Assistant": {
      "type": "http",
      "url": "http://haserver.local:8123/api/mcp",
      "headers": {
        "Authorization": "Bearer <long lived access token>"
      },
      "toolOverrides": {
        "GetLiveContext": {
          "description": "Get the current state of Home Assistant entities (sensors, switches, lights, media players, etc). Call with NO arguments first to discover ALL entities, then use filters to narrow down.",
          "properties": {
            "name": {
              "description": "Entity name to filter by (case-insensitive partial match). Use exact names from discovery results. Examples: \"pool pump\", \"car battery level\", \"Pool heating\", \"KitchenSpkr\"."
            },
            "domain": {
              "description": "Entity type filter. Examples: \"sensor\", \"switch\", \"light\", \"media_player\", \"lock\", \"binary_sensor\", \"automation\", \"cover\", \"climate\"."
            },
            "area": {
              "description": "Area or room name to filter by (case-insensitive). Examples: \"Kitchen\", \"Lounge\", \"Bedroom\"."
            }
          }
        }
      }
    }
  }
}
